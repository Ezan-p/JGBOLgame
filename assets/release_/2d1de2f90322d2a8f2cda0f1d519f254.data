#ifdef GL_ES
precision mediump float;
#endif

// 1
varying vec2 v_texCoord;
uniform sampler2D u_texture;
uniform float u_time;

void main()
{
	vec4 color;
	color = texture2D(u_texture, v_texCoord).rgba;
    // 4
    
    if(color.a != 0.0)
    {
		float _c = (color.r + color.g + color.b)/3.0;
		color.rgb = vec3(_c, _c, _c);
	}
	gl_FragColor = color.rgba;
}