#ifdef GL_ES
precision mediump float;
#endif

// 1
varying vec2 v_texCoord;
uniform sampler2D u_texture;
uniform float originX;
uniform float originY;
uniform float width;
uniform float height;

void main()
{
	vec4 color;
	color = texture2D(u_texture, v_texCoord).rgba;
    // 4
    //vec2 origin = vec2(0.5, 0.5);
	//float width = 0.2;
	//float height = 0.2;
	
	if(v_texCoord.x > originX && v_texCoord.x < originX + width
		&& v_texCoord.y > originY && v_texCoord.y < originY + height )
	{
		color.a = 0.0;
	}
	
	gl_FragColor = color.rgba;
}